# ==============================================================================
# 1. Google Gemini Decisions API (`serve` & `import`)
# ==============================================================================
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Minimum confidence [0.0–1.0] required before falling back to `other`
CONFIDENCE_THRESHOLD=0.55

# Vision token resolution: low | medium | high | ultra_high
GEMINI_IMAGE_RESOLUTION=medium


# ==============================================================================
# 2. Discord Parent Channel Webhook & Category Thread IDs (`serve` & `import`)
# How to get Thread IDs: Discord Settings -> Advanced -> Developer Mode ->
# Right-click each thread in your channel -> "Copy Thread ID"
# ==============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/your_webhook_token_here

THREAD_ID_SFW_FURRY=1234567890123456781
THREAD_ID_NSFW=1234567890123456782
THREAD_ID_MEME=1234567890123456784
THREAD_ID_TECH=1234567890123456785
THREAD_ID_OTHER=1234567890123456786


# ==============================================================================
# 3. X (Twitter) Activity API & OAuth 1.0a Credentials (`serve` & `subscribe`)
# ==============================================================================
# Numeric user ID of your X account (whose outbound likes will be tracked)
X_USER_ID=1234567890

# X App Consumer Keys (API Key & Secret from developer.x.com)
# Note: X_CONSUMER_SECRET is also used to verify `/webhook/x` CRC & HMAC signatures
X_CONSUMER_KEY=your_x_consumer_key_here
X_CONSUMER_SECRET=your_x_consumer_secret_here

# OAuth 1.0a User Context Access Token & Secret generated for X_USER_ID
X_ACCESS_TOKEN=your_x_user_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_user_access_token_secret_here

# Optional: App-only OAuth 2.0 Bearer Token (used as primary auth for GET/POST /2/webhooks if set)
X_BEARER_TOKEN=

# Public HTTPS URL pointing to your running server's `/webhook/x` endpoint (required for `subscribe`)
PUBLIC_WEBHOOK_URL=https://your-domain.example.com/webhook/x


# ==============================================================================
# 4. Storage, BetterTwitFix, Archive Import & HTTP Server (Optional)
# ==============================================================================
DB_PATH=likes.db
VXTWITTER_API_BASE=https://api.vxtwitter.com
IMPORT_DELAY_SECONDS=1.5

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO